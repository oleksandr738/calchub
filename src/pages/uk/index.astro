---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout
  title="CalcHub — безкоштовні онлайн-калькулятори"
  description="Безкоштовні онлайн-калькулятори: фінанси, будівництво, авто та повсякденні розрахунки."
  lang="uk"
>
  <main class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-4xl font-bold tracking-tight text-brand-700">CalcHub</h1>
    <p class="mt-4 text-lg text-slate-600">
      Основа проєкту працює. Astro і Tailwind підключені.
    </p>
    <button class="mt-8 rounded-lg bg-brand-600 px-5 py-3 font-medium text-white hover:bg-brand-700">
      Тестова кнопка
    </button>
  </main>
</MainLayout>