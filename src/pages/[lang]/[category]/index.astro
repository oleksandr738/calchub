---
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CalculatorCard from '../../../components/CalculatorCard.astro';
import { langCodes, useTranslations, type Lang } from '../../../i18n';
import { categories, type CategorySlug } from '../../../utils/categories';
import { calculatorsInCategory, calculatorUrl } from '../../../calculators/registry';

export function getStaticPaths() {
  return langCodes.flatMap((lang) =>
    categories.map((c) => ({ params: { lang, category: c.slug } })),
  );
}

const lang = Astro.params.lang as Lang;
const category = Astro.params.category as CategorySlug;
const t = useTranslations(lang);
const items = calculatorsInCategory(category);
const name = t(`categories.${category}.name`);
---

<MainLayout
  title={`${name} — CalcHub`}
  description={t(`categories.${category}.description`)}
  lang={lang}
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumbs items={[{ label: t('ui.home'), href: `/${lang}/` }, { label: name }]} />
    <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">{name}</h1>
    <p class="mt-3 text-lg text-slate-600">{t(`categories.${category}.description`)}</p>

    {items.length > 0 ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((c) => (
          <CalculatorCard
            href={calculatorUrl(lang, c)}
            icon={c.icon}
            name={t(`calculators.${c.slug}.name`)}
            description={t(`calculators.${c.slug}.description`)}
          />
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-2xl border border-dashed border-slate-300 p-8 text-center text-slate-600">
        {t('ui.noCalculators')}
      </p>
    )}
  </div>
</MainLayout>
