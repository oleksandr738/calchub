---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, switchLangPath, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
}

const { title, description = '', lang } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: new URL(switchLangPath(path, code), Astro.site).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />
  </head>
  <body class="bg-white font-sans text-slate-900 antialiased">
    <div class="flex min-h-screen flex-col">
      <Header lang={lang} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
