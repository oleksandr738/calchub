---
import type { CategorySlug } from '../utils/categories';
import { categoryStyles } from '../utils/categoryStyles';

interface Props {
  href: string;
  category: CategorySlug;
  icon: string;
  name: string;
  description: string;
}
const { href, category, icon, name, description } = Astro.props;
const style = categoryStyles[category];
---

<a
  href={href}
  class:list={['group flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 transition', style.hover]}
>
  <span
    class:list={['grid h-11 w-11 shrink-0 place-items-center rounded-xl text-xl font-semibold', style.tile]}
    aria-hidden="true"
  >
    {icon}
  </span>
  <span>
    <span class="block text-lg font-semibold text-slate-900 group-hover:text-brand-700">{name}</span>
    <span class="mt-1 block text-sm text-slate-600">{description}</span>
  </span>
</a>
