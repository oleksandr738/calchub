---
interface Props {
  href: string;
  icon: string;
  name: string;
  description: string;
}
const { href, icon, name, description } = Astro.props;
---

<a
  href={href}
  class="group flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-brand-500 hover:shadow-md"
>
  <span
    class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-xl font-semibold text-brand-700"
    aria-hidden="true"
  >
    {icon}
  </span>
  <span>
    <span class="block text-lg font-semibold text-slate-900 group-hover:text-brand-700">{name}</span>
    <span class="mt-1 block text-sm text-slate-600">{description}</span>
  </span>
</a>
