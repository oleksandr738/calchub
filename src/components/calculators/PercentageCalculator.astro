---
import { useTranslations, type Lang } from '../../i18n';
import { numberLocales } from '../../utils/formatNumber';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = 'calculators.percentage-calculator';

const modeIds = ['percentOf', 'whatPercent', 'change', 'increase', 'decrease'] as const;

// Формули однакові для всіх мов (a, b — значення з полів)
const formulas: Record<(typeof modeIds)[number], string> = {
  percentOf: 'a% × b ÷ 100',
  whatPercent: 'a ÷ b × 100',
  change: '(b − a) ÷ |a| × 100',
  increase: 'a × (1 + b ÷ 100)',
  decrease: 'a × (1 − b ÷ 100)',
};

// Тексти для скрипта в браузері
const messages = {
  hint: t('calc.hint'),
  invalid: t('calc.invalid'),
  divisionByZero: t('calc.divisionByZero'),
  overflow: t('calc.overflow'),
  copy: t('calc.copy'),
  copied: t('calc.copied'),
  modes: Object.fromEntries(
    modeIds.map((id) => [
      id,
      {
        labelA: t(`${base}.modes.${id}.labelA`),
        labelB: t(`${base}.modes.${id}.labelB`),
        placeholderA: t(`${base}.modes.${id}.placeholderA`),
        placeholderB: t(`${base}.modes.${id}.placeholderB`),
      },
    ]),
  ),
};

const inputClass =
  'mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-lg text-slate-900 placeholder:text-slate-400 aria-[invalid=true]:border-red-600';
---

<section
  class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
  data-percentage-calculator
  data-locale={numberLocales[lang]}
  data-messages={JSON.stringify(messages)}
>
  <div>
    <label for="pc-mode" class="block text-sm font-medium text-slate-700">{t('calc.mode')}</label>
    <select id="pc-mode" data-role="mode" class={inputClass}>
      {modeIds.map((id) => <option value={id}>{t(`${base}.modes.${id}.name`)}</option>)}
    </select>
  </div>

  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    <div>
      <label for="pc-a" data-role="labelA" class="block text-sm font-medium text-slate-700"></label>
      <input id="pc-a" data-role="a" type="text" inputmode="decimal" autocomplete="off" aria-describedby="pc-error" class={inputClass} />
    </div>
    <div>
      <label for="pc-b" data-role="labelB" class="block text-sm font-medium text-slate-700"></label>
      <input id="pc-b" data-role="b" type="text" inputmode="decimal" autocomplete="off" aria-describedby="pc-error" class={inputClass} />
    </div>
  </div>

  <p id="pc-error" data-role="error" class="mt-3 hidden text-sm text-red-700"></p>

  <div class="mt-5 rounded-xl border-l-4 border-sun-400 bg-brand-50 p-4" aria-live="polite">
    <p class="text-sm font-medium text-brand-700">{t('calc.result')}</p>
    <p data-role="result" class="mt-1 break-words text-3xl font-bold text-slate-900"></p>
    <p data-role="steps" class="mt-1 break-words text-sm text-slate-600"></p>
  </div>

  <div class="mt-4 flex flex-wrap gap-3">
    <button
      type="button"
      data-role="reset"
      class="rounded-lg border border-slate-300 px-4 py-2.5 font-medium text-slate-700 hover:bg-slate-50"
    >
      {t('calc.reset')}
    </button>
    <button
      type="button"
      data-role="copy"
      disabled
      class="rounded-lg bg-brand-600 px-4 py-2.5 font-medium text-white hover:bg-brand-700 disabled:cursor-not-allowed disabled:bg-slate-300"
    >
      {t('calc.copy')}
    </button>
  </div>
</section>

<section class="mt-12" aria-labelledby="pc-how">
  <h2 id="pc-how" class="text-2xl font-semibold">{t('ui.howItWorks')}</h2>
  <dl class="mt-4 space-y-5">
    {modeIds.map((id) => (
      <div class="rounded-2xl border border-slate-200 p-5">
        <dt class="font-semibold text-slate-900">{t(`${base}.modes.${id}.name`)}</dt>
        <dd class="mt-2 text-slate-600">{t(`${base}.modes.${id}.explain`)}</dd>
        <dd class="mt-3 inline-block rounded-lg bg-slate-100 px-3 py-1.5 font-mono text-sm text-slate-800">
          {formulas[id]}
        </dd>
        <dd class="mt-3 text-sm text-slate-600">
          <span class="font-medium text-slate-800">{t('ui.example')}:</span>
          {t(`${base}.modes.${id}.example`)}
        </dd>
      </div>
    ))}
  </dl>
</section>

<script>
  import { calculatePercentage, type PercentageMode } from '../../calculators/finance/percentage';
  import { parseNumber } from '../../utils/validation';
  import { formatNumber } from '../../utils/formatNumber';

  // Шаблони розрахунку. {a}, {b}, {r} — підставляються відформатовані числа
  const steps: Record<PercentageMode, string> = {
    percentOf: '{a}% × {b} ÷ 100 = {r}',
    whatPercent: '{a} ÷ {b} × 100 = {r}',
    change: '({b} − {a}) ÷ |{a}| × 100 = {r}',
    increase: '{a} × (1 + {b}% ÷ 100) = {r}',
    decrease: '{a} × (1 − {b}% ÷ 100) = {r}',
  };

  const root = document.querySelector<HTMLElement>('[data-percentage-calculator]');

  if (root) {
    const locale = root.dataset.locale ?? 'en-GB';
    const msg = JSON.parse(root.dataset.messages ?? '{}');
    const el = <T extends HTMLElement>(role: string) => root.querySelector<T>(`[data-role="${role}"]`)!;

    const modeSelect = el<HTMLSelectElement>('mode');
    const inputA = el<HTMLInputElement>('a');
    const inputB = el<HTMLInputElement>('b');
    const labelA = el('labelA');
    const labelB = el('labelB');
    const errorBox = el('error');
    const resultBox = el('result');
    const stepsBox = el('steps');
    const resetBtn = el<HTMLButtonElement>('reset');
    const copyBtn = el<HTMLButtonElement>('copy');

    let resultText = '';
    let copyTimer: number | undefined;

    function showError(text: string, fields: HTMLInputElement[]) {
      errorBox.textContent = text;
      errorBox.classList.toggle('hidden', text === '');
      for (const f of [inputA, inputB]) {
        f.setAttribute('aria-invalid', fields.includes(f) ? 'true' : 'false');
      }
    }

    function clearResult(message: string) {
      resultText = '';
      resultBox.textContent = '—';
      stepsBox.textContent = message;
      copyBtn.disabled = true;
    }

    function update() {
      const mode = modeSelect.value as PercentageMode;
      const m = msg.modes[mode];
      labelA.textContent = m.labelA;
      labelB.textContent = m.labelB;
      inputA.placeholder = m.placeholderA;
      inputB.placeholder = m.placeholderB;

      const a = parseNumber(inputA.value);
      const b = parseNumber(inputB.value);

      const invalidFields: HTMLInputElement[] = [];
      if (a.status === 'invalid') invalidFields.push(inputA);
      if (b.status === 'invalid') invalidFields.push(inputB);
      if (invalidFields.length > 0) {
        showError(msg.invalid, invalidFields);
        clearResult('');
        return;
      }

      if (a.status !== 'ok' || b.status !== 'ok') {
        showError('', []);
        clearResult(msg.hint);
        return;
      }

      const result = calculatePercentage(mode, a.value, b.value);
      if (!result.ok) {
        const culprit = mode === 'whatPercent' ? inputB : mode === 'change' ? inputA : null;
        showError(msg[result.error], culprit ? [culprit] : []);
        clearResult('');
        return;
      }

      showError('', []);
      const r = formatNumber(result.value, locale) + (result.unit === 'percent' ? '%' : '');
      resultText = r;
      resultBox.textContent = r;
      stepsBox.textContent = steps[mode]
        .replace(/\{a\}/g, formatNumber(a.value, locale))
        .replace(/\{b\}/g, formatNumber(b.value, locale))
        .replace('{r}', r);
      copyBtn.disabled = false;
    }

    modeSelect.addEventListener('change', update);
    inputA.addEventListener('input', update);
    inputB.addEventListener('input', update);

    resetBtn.addEventListener('click', () => {
      inputA.value = '';
      inputB.value = '';
      update();
      inputA.focus();
    });

    copyBtn.addEventListener('click', async () => {
      if (!resultText) return;
      try {
        await navigator.clipboard.writeText(resultText);
        copyBtn.textContent = msg.copied;
        window.clearTimeout(copyTimer);
        copyTimer = window.setTimeout(() => {
          copyBtn.textContent = msg.copy;
        }, 1500);
      } catch {
        // Буфер обміну недоступний: нічого не робимо, результат видно на екрані
      }
    });

    update();
  }
</script>
