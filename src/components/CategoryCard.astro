---
interface Props {
  href: string;
  icon: string;
  name: string;
  description: string;
}
const { href, icon, name, description } = Astro.props;
---

<a
  href={href}
  class="group block rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-brand-500 hover:shadow-md"
>
  <div class="text-3xl" aria-hidden="true">{icon}</div>
  <h3 class="mt-3 text-lg font-semibold text-slate-900 group-hover:text-brand-700">{name}</h3>
  <p class="mt-1 text-sm text-slate-600">{description}</p>
</a>
