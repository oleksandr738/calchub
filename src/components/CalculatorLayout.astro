---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CalculatorCard from './CalculatorCard.astro';
import { useTranslations, type Lang } from '../i18n';
import { calculatorsInCategory, calculatorUrl, type CalculatorMeta } from '../calculators/registry';
import { breadcrumbLd, faqLd, webAppLd, absoluteUrl } from '../utils/seo';

interface Props {
  lang: Lang;
  calc: CalculatorMeta;
}
const { lang, calc } = Astro.props;
const t = useTranslations(lang);
const base = `calculators.${calc.slug}`;

const faq = Array.from({ length: calc.faqCount }, (_, i) => ({
  q: t(`${base}.faq${i + 1}q`),
  a: t(`${base}.faq${i + 1}a`),
}));
const related = calculatorsInCategory(calc.category).filter((c) => c.slug !== calc.slug);

const pagePath = calculatorUrl(lang, calc);
const name = t(`${base}.name`);
const jsonLd = [
  breadcrumbLd(
    [
      { name: t('ui.home'), path: `/${lang}/` },
      { name: t(`categories.${calc.category}.name`), path: `/${lang}/${calc.category}/` },
      { name, path: pagePath },
    ],
    Astro.site!,
  ),
  webAppLd({
    name,
    description: t(`${base}.description`),
    url: absoluteUrl(pagePath, Astro.site!),
    lang,
  }),
  ...(faq.length > 0 ? [faqLd(faq)] : []),
];
---

<MainLayout title={t(`${base}.title`)} description={t(`${base}.description`)} lang={lang} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs
      items={[
        { label: t('ui.home'), href: `/${lang}/` },
        { label: t(`categories.${calc.category}.name`), href: `/${lang}/${calc.category}/` },
        { label: t(`${base}.name`) },
      ]}
    />

    <h1 class="mt-5 text-3xl font-bold tracking-tight sm:text-4xl">{t(`${base}.name`)}</h1>
    <p class="mt-3 text-lg text-slate-600">{t(`${base}.intro`)}</p>

    <slot />

    {faq.length > 0 && (
      <section class="mt-12" aria-labelledby="faq-title">
        <h2 id="faq-title" class="text-2xl font-semibold">{t('ui.faq')}</h2>
        <div class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200">
          {faq.map((item) => (
            <details class="group px-5 py-4">
              <summary class="cursor-pointer list-none font-medium text-slate-900 marker:content-none">
                {item.q}
              </summary>
              <p class="mt-2 text-slate-600">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-12" aria-labelledby="related-title">
        <h2 id="related-title" class="text-2xl font-semibold">{t('ui.related')}</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {related.map((c) => (
            <CalculatorCard
              href={calculatorUrl(lang, c)}
              icon={c.icon}
              name={t(`calculators.${c.slug}.name`)}
              description={t(`calculators.${c.slug}.description`)}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</MainLayout>
