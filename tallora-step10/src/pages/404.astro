---
import MainLayout from '../layouts/MainLayout.astro';
import { languages, defaultLang, useTranslations, type Lang } from '../i18n';
import { BRAND } from '../utils/brand';

const codes = Object.keys(languages) as Lang[];
const tDefault = useTranslations(defaultLang);
---

<MainLayout title={`404 — ${BRAND}`} description={tDefault('notFound.text')} lang={defaultLang} noindex>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-6xl font-bold text-brand-600" aria-hidden="true">404</p>
    <div class="mt-8 space-y-8">
      {codes.map((code) => {
        const t = useTranslations(code);
        return (
          <section lang={code}>
            <h1 class="text-2xl font-bold">{t('notFound.title')}</h1>
            <p class="mt-2 text-slate-600">{t('notFound.text')}</p>
            <a
              href={`/${code}/`}
              class="mt-4 inline-block rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white hover:bg-brand-700"
            >
              {t('notFound.home')}
            </a>
          </section>
        );
      })}
    </div>
  </div>
</MainLayout>
